<idea-plugin>
    <id>com.pushpull.deploy</id>
    <name>Push &amp; Pull</name>
    <vendor email="support@example.com" url="https://example.com">Push &amp; Pull</vendor>

    <description><![CDATA[
        A deployment interface for JetBrains IDEs with upload and download actions in editor, toolbar, and project context menus. Push and pull files or folders through Rclone with support for FTP, SFTP, FTPS, WebDAV, S3, S3-compatible storage, SMB, Swift, Azure Blob, Google Cloud Storage, Google Drive, OneDrive, Backblaze B2, remote servers, and SSH workflows.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Push &amp; Pull" displayType="BALLOON" isLogByDefault="true"/>
        <projectConfigurable
            id="push.pull.settings"
            parentId="tools"
            displayName="Push &amp; Pull"
            instance="com.deploymenthost.jetbrains.PushPullConfigurable"/>
    </extensions>

    <actions>
        <group
            id="Deploy.ToolsMenu"
            text="Push &amp; Pull"
            popup="true"
            icon="/icons/up.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>

        <action
            id="Deploy.PushFile"
            class="com.deploymenthost.jetbrains.UploadFileAction"
            text="Push (Upload)"
            description="Upload the selected file"
            icon="/icons/up.svg">
            <add-to-group group-id="Deploy.ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="MainToolBar" anchor="last"/>
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
        </action>

        <action
            id="Deploy.PullFile"
            class="com.deploymenthost.jetbrains.DownloadFileAction"
            text="Pull (Download)"
            description="Download the selected file"
            icon="/icons/down.svg">
            <add-to-group group-id="Deploy.ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="MainToolBar" anchor="last"/>
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
        </action>

        <action
            id="Deploy.PushFolder"
            class="com.deploymenthost.jetbrains.UploadFolderAction"
            text="Push Folder (Upload)"
            description="Upload the selected folder"
            icon="/icons/up.svg">
            <add-to-group group-id="Deploy.ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <action
            id="Deploy.PullFolder"
            class="com.deploymenthost.jetbrains.DownloadFolderAction"
            text="Pull Folder (Download)"
            description="Download the selected folder"
            icon="/icons/down.svg">
            <add-to-group group-id="Deploy.ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
