<idea-plugin>
    <id>com.pushpull.deploy</id>
    <name>Push &amp; Pull</name>
    <vendor email="support@example.com" url="https://example.com">Push &amp; Pull</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Push &amp; Pull" displayType="BALLOON" isLogByDefault="true"/>
        <projectConfigurable
            id="push.pull.settings"
            parentId="tools"
            displayName="Push &amp; Pull"
            instance="com.deploymenthost.jetbrains.PushPullConfigurable"/>
    </extensions>

    <actions>
        <group
            id="Deploy.ToolsMenu"
            text="Push &amp; Pull"
            popup="true"
            icon="/icons/up.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>

        <action
            id="Deploy.CompareFile"
            class="com.deploymenthost.jetbrains.CompareFileAction"
            text="Compare Online with Local"
            description="Compare Online with Local"
            icon="/icons/compare.svg">
            <add-to-group group-id="MainToolBar" anchor="before" relative-to-action="Deploy.PushFile"/>
            <add-to-group group-id="MainToolbarRight" anchor="before" relative-to-action="Deploy.PushFile"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="Deploy.PullFile"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Deploy.PullFile"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="after" relative-to-action="Deploy.PullFile"/>
        </action>

        <action
            id="Deploy.PushFile"
            class="com.deploymenthost.jetbrains.UploadFileAction"
            text="Push (Upload)"
            description="Upload the selected file"
            icon="/icons/up.svg">
            <keyboard-shortcut keymap="$default" first-keystroke="control UP"/>
            <add-to-group group-id="Deploy.ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <add-to-group group-id="MainToolBar" anchor="last"/>
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
        </action>

        <action
            id="Deploy.PullFile"
            class="com.deploymenthost.jetbrains.DownloadFileAction"
            text="Pull (Download)"
            description="Download the selected file"
            icon="/icons/down.svg">
            <keyboard-shortcut keymap="$default" first-keystroke="control DOWN"/>
            <add-to-group group-id="Deploy.ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="Deploy.PushFile"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Deploy.PushFile"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="after" relative-to-action="Deploy.PushFile"/>
            <add-to-group group-id="MainToolBar" anchor="last"/>
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
        </action>

        <action
            id="Deploy.PushFolder"
            class="com.deploymenthost.jetbrains.UploadFolderAction"
            text="Push Folder (Upload)"
            description="Upload the selected folder"
            icon="/icons/up.svg">
            <add-to-group group-id="Deploy.ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="Deploy.CompareFile"/>
        </action>

        <action
            id="Deploy.PullFolder"
            class="com.deploymenthost.jetbrains.DownloadFolderAction"
            text="Pull Folder (Download)"
            description="Download the selected folder"
            icon="/icons/down.svg">
            <add-to-group group-id="Deploy.ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="Deploy.PushFolder"/>
        </action>
    </actions>
</idea-plugin>
