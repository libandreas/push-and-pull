{
	"name": "push-and-pull",
	"displayName": "RZilla: FTP, SFTP & WebDAV",
	"description": "FTP, SFTP and WebDAV client for VS Code. Upload, download, sync folders and compare local and remote files. Powered by rclone.",
	"keywords": [
		"ftp",
		"sftp",
		"ftps",
		"webdav",
		"rclone",
		"upload",
		"download",
		"deploy",
		"deployment",
		"file-transfer",
		"remote",
		"compare",
		"diff",
		"s3",
		"smb",
		"cloud",
		"google-drive",
		"onedrive"
	],
	"version": "26.10.26",
	"publisher": "pa-andreas",
	"license": "GPL-3.0-or-later",
	"bugs": {
		"url": "https://github.com/libandreas/push-and-pull/issues"
	},
	"icon": "favicon-4.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/libandreas/push-and-pull.git"
	},
	"scripts": {
		"build:vscode": "node build-vscode.mjs",
		"build:jetbrains": "node build-jetbrains.mjs"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:pushR.compareFile",
		"onCommand:pushR.uploadFile",
		"onCommand:pushR.downloadFile",
		"onCommand:pushR.uploadFolder",
		"onCommand:pushR.downloadFolder",
		"onCommand:pushR.syncFolder"
	],
	"main": "./extension-4.js",
	"contributes": {
		"configuration": {
			"title": "RZilla",
			"properties": {
				"pushPull.transfers": {
					"type": "number",
					"default": 2,
					"minimum": 1,
					"description": "RZilla rclone arg: --transfers. Number of file transfers to run in parallel."
				},
				"pushPull.checkers": {
					"type": "number",
					"default": 4,
					"minimum": 1,
					"description": "RZilla rclone arg: --checkers. Number of checkers to run in parallel while scanning and comparing files."
				}
			}
		},
		"commands": [
			{
				"command": "pushR.compareFile",
				"title": "Compare Online with Local",
				"icon": {
					"light": "media/compare.svg",
					"dark": "media/compare.svg"
				}
			},
			{
				"command": "pushR.uploadFile",
				"title": "Push (Upload)",
				"icon": {
					"light": "media/up.svg",
					"dark": "media/up.svg"
				}
			},
			{
				"command": "pushR.downloadFile",
				"title": "Pull (Download)",
				"icon": {
					"light": "media/down.svg",
					"dark": "media/down.svg"
				}
			},
			{
				"command": "pushR.syncFolder",
				"title": "Sync Folder (Bsyncs)"
			},
			{
				"command": "pushR.uploadFolder",
				"title": "Push Folder (Upload)",
				"icon": {
					"light": "media/up.svg",
					"dark": "media/up.svg"
				}
			},
			{
				"command": "pushR.downloadFolder",
				"title": "Pull Folder (Download)",
				"icon": {
					"light": "media/down.svg",
					"dark": "media/down.svg"
				}
			}
		],
		"keybindings": [
			{
				"command": "pushR.uploadFile",
				"key": "ctrl+up",
				"mac": "cmd+up",
				"when": "editorTextFocus && resourceScheme == file"
			},
			{
				"command": "pushR.downloadFile",
				"key": "ctrl+down",
				"mac": "cmd+down",
				"when": "editorTextFocus && resourceScheme == file"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "pushR.uploadFile",
					"when": "resourceScheme == file && explorerResourceIsFolder == false",
					"group": "navigation@50"
				},
				{
					"command": "pushR.downloadFile",
					"when": "resourceScheme == file && explorerResourceIsFolder == false",
					"group": "navigation@51"
				},
				{
					"command": "pushR.compareFile",
					"when": "resourceScheme == file && explorerResourceIsFolder == false",
					"group": "navigation@52"
				},
				{
					"command": "pushR.uploadFolder",
					"when": "resourceScheme == file && explorerResourceIsFolder == true",
					"group": "navigation@52"
				},
				{
					"command": "pushR.downloadFolder",
					"when": "resourceScheme == file && explorerResourceIsFolder == true",
					"group": "navigation@53"
				},
				{
					"command": "pushR.syncFolder",
					"when": "resourceScheme == file && explorerResourceIsFolder == true",
					"group": "navigation@54"
				}
			],
			"openEditors/context": [
				{
					"command": "pushR.uploadFile",
					"when": "resourceScheme == file",
					"group": "navigation@50"
				},
				{
					"command": "pushR.downloadFile",
					"when": "resourceScheme == file",
					"group": "navigation@51"
				},
				{
					"command": "pushR.compareFile",
					"when": "resourceScheme == file",
					"group": "navigation@52"
				}
			],
			"editor/context": [
				{
					"command": "pushR.uploadFile",
					"when": "resourceScheme == file",
					"group": "navigation@50"
				},
				{
					"command": "pushR.downloadFile",
					"when": "resourceScheme == file",
					"group": "navigation@51"
				},
				{
					"command": "pushR.compareFile",
					"when": "resourceScheme == file",
					"group": "navigation@52"
				}
			],
			"editor/title": [
				{
					"command": "pushR.compareFile",
					"when": "resourceScheme == file",
					"group": "navigation@-10000"
				},
				{
					"command": "pushR.downloadFile",
					"when": "resourceScheme == file",
					"group": "navigation@-9998"
				},
				{
					"command": "pushR.uploadFile",
					"when": "resourceScheme == file",
					"group": "navigation@-9999"
				}
			]
		}
	}
}
